# Copy to config/.env and fill in. Never commit config/.env.
CORPUS_PATH=full_corpus/full_corpus_clean.jsonl
FAISS_INDEX=data/faiss.index
FAISS_META=data/faiss_meta.jsonl
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=password

# groq | ollama
LLM_PROVIDER=groq
# Groq: a model listed at https://console.groq.com/docs/models  |  Ollama: e.g. llama3.1
LLM_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=your_key_here
OLLAMA_URL=http://localhost:11434

TOP_K=5
