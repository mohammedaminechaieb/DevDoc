# Copy to config/.env and fill in. Never commit config/.env.
CORPUS_PATH=full_corpus/full_corpus_clean.jsonl
FAISS_INDEX=data/faiss.index
FAISS_META=data/faiss_meta.jsonl
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=password

# gemini | groq | ollama   (LLM_MODEL defaults per provider; override if needed)
LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=
OLLAMA_URL=http://localhost:11434
# requests per minute for the graph LLM extraction (Gemini free tier ~10-15)
LLM_RPM=10

TOP_K=5
